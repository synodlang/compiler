# package main
use example.com/t/p
use std/lesson
use std/net
use std/sim

define main
  set a to (sim.Spawn p)
  set b to (sim.Spawn p)
  set a.p.Peers to {b}
  net.Latency between 10ms and 10ms
  lesson.Ask "What happens to the second message?"
  deliver (message p.Go with k 1) to a
  after 1s
    deliver (message p.Go with k 2) to a
    lesson.Note "b now holds two messages."
