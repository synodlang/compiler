# package main
use example.com/t/p
use std/net
use std/sim

define main
  set a to (sim.Spawn p)
  set b to (sim.Spawn p)
  set a.p.Peers to {b}
  net.Latency between 20ms and 20ms
  net.DropNext "Msg" from a to b
  deliver (message p.Go with k 1) to a
  after 1s
    deliver (message p.Go with k 2) to a
