# package lk
use std/look
use std/net
use std/sim

when sim.Started
  look.Layout "row"

when (sim.Added n)
  draw (look.Card for n) as card for n

when (net.Sent m from a to b)
  draw (look.Circle 5) as ball
  look.Fill ball with (look.MessageColor m)
  look.Flight ball from (card of a) to (card of b) for m
