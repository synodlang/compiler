# package look
use std/sim
use std/theme

# The standard node card: a box and a name label, shaped and filled by `theme.NodeShape` and `theme.NodeFill`
define Card for [n: node]
  if (theme.NodeShape is "circle")
    draw (Circle 32) as box
    if (theme.NodeFill is "solid")
      Fill box with theme.Ink
    if (theme.NodeFill is "outline")
      Stroke box with theme.Ink
    draw (Label (sim.Name n)) as name
    if (theme.NodeFill is "solid")
      Fill name with theme.Paper
    if (theme.NodeFill is "outline")
      Fill name with theme.Ink
    result (Group {box, name})
  draw (Rect 96 by 56) as box
  if (theme.NodeFill is "solid")
    Fill box with theme.Ink
  if (theme.NodeFill is "outline")
    Stroke box with theme.Ink
  draw (Label (sim.Name n)) as name
  if (theme.NodeFill is "solid")
    Fill name with theme.Paper
  if (theme.NodeFill is "outline")
    Fill name with theme.Ink
  result (Group {box, name})

# Move along a straight path
define Travel [s: shape] from [a: shape] to [b: shape] over [d: time]
  Tween "x" of s to a over 0s
  Tween "y" of s to a over 0s
  Tween "x" of s to b over d
  Tween "y" of s to b over d

# Fade out, then delete
define Remove [s: shape]
  Fade s to 0
  after 300ms
    delete s

# A rect of the canvas inset by `theme.Margin`
define Frame
  draw (Rect (1040 minus (2 times theme.Margin)) by (650 minus (2 times theme.Margin))) as frame
  result frame
