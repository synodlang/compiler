# package main

use std/sim
use std/net
use std/lesson

use github.com/synodlang/examples/paxos



define main   
  sim.Seed  (105)
  net.Latency between 10ms  and 0.04s
  set nodes to (sim.Cluster of 3 running paxos)
  paxos.Meet nodes
  deliver (message paxos.Start with Value "x") to ( item 0 of nodes )
  after 15.0ms
    deliver (message paxos.Start with Value "y") to (item 2 of nodes)
    lesson.Ask "Two proposers are racing. Can both x and y be chosen?" choosing {"Yes: each proposer's value is chosen at its own ballot", "No: the higher ballot wins, so y alone is chosen", "No: the second proposer learns of x and proposes x too", "Neither: the proposers block each other forever"}
  sim.StopAt 2000ms