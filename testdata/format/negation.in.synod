# package demo
define Tests
  set a to (not (x is y))
  set b to (not (x is not y))
  set c to (not (x is in xs))
  set d to (not (x is not in xs))
  set e to (not (x less than 3))
  set f to (not (x at least 3))
  set g to (not (x more than 3))
  set h to (not (x at most 3))
