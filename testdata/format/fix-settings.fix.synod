# package paxos
use std/net

define [n: Node] Promise to [p: node]
  net.Send (message Promise with prior n.Promised, number 7, extra 3) to p
  set m to (message Promise with number 1, prior 2)
  if (n.Ready)
    set k to (message Same with a 1, b 2)
  set odd to (message Wide with b (x plus 1), a 2)
  set done to (message Promise with number 1)
