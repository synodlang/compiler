# package main
use github.com/synodlang/examples/paxos
use std/lesson
use std/net
use std/sim

define main
  sim.Seed 7
  net.Latency between 10ms and 40ms
  set nodes to (sim.Cluster of 3 running paxos)
  paxos.Meet nodes
  deliver (message paxos.Start with Value "x") to (item 0 of nodes)
  after 15ms
    deliver (message paxos.Start with Value "y") to (item 2 of nodes)
    lesson.Ask "Two proposers are racing. Can both x and y be chosen?"
  sim.StopAt 2s
