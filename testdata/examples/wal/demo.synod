# package main
use github.com/synodlang/examples/wal
use std/lesson
use std/lists
use std/sim
use std/text

define main
  set db to (sim.Spawn wal)
  each i in (lists.Range 1 to 12)
    after (i times 300ms)
      deliver (message wal.Put with Key (text.Join {"k", (text.From i)}), Value (text.From i)) to db
  after 3100ms
    sim.Crash db
    lesson.Ask "The last checkpoint was at 2s. Which writes survive the crash?" choosing {"Only the six writes made before the checkpoint", "All ten acknowledged writes: six from the checkpoint, four replayed from the log", "None: memory is lost with the crash", "Every write, including the one sent during the outage"}
  after 3500ms
    sim.Restart db
    lesson.Note "Writes after the checkpoint come back from the log."
  sim.StopAt 5s
