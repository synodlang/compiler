# package main
use github.com/synodlang/examples/twopc
use std/lesson
use std/net
use std/sim

define main
  sim.Seed 1
  net.Latency between 10ms and 30ms
  set coordinator to (sim.Spawn twopc)
  set participants to (sim.Cluster of 3 running twopc)
  twopc.Coordinate participants from coordinator
  deliver (message twopc.Begin with Tx 1) to coordinator
  after 45ms
    sim.Crash coordinator
    lesson.Ask "The coordinator crashed while votes were in flight. What can a prepared participant do?" choosing {"Commit, because it voted yes", "Abort on its own, because the coordinator is gone", "Wait for the coordinator: it voted yes, so it cannot decide alone", "Elect a new coordinator among the participants"}
  sim.StopAt 3s
