# package main
use example.com/t/p
use std/net
use std/sim

define main
  set a to (sim.Spawn p)
  set b to (sim.Spawn p)
  set a.p.Peer to b
  net.Latency between 20ms and 20ms
  deliver (message p.Hi with k 0) to a
  after 10ms
    sim.Crash b
  after 5s
    sim.Crash b
    sim.Remove b
    sim.Crash b
    sim.Restart b
