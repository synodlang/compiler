# package p
use example.com/t/q
use example.com/t/r/q
use std/net
use std/net

Ping has
  set seq to 0
  set big to 0

Node has
  set x to 0
  set y to 0

define [n: Node] Go
  net.Send (message Ping with seq 1, seq 2) from n to n
  net.Send (message Ping with seq 2, big 1) from n to n

define Third
  result q.One
