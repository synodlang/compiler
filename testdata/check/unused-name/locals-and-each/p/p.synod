# package p
Node has
  set l to {}
  set m to {}

define [n: Node] Go
  set unused to 1
  set twice to 1
  set twice to 2
  each i, e in n.l
    set n.l to {e}
  each k, v in n.m
    set item k of n.m to 1
  each j in n.l
    set n.l to {}
  set used to 1
  set item 0 of n.l to used
  set item "a" of n.m to 1
  set base to {}
  set item 0 of base to 1
