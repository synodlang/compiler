# package p
Node has
  set Count to 0
  set name to ""

define [n: Node] Version
  result n.Count

define [n: Node] Bump
  set n.Count to (n.Count plus 1)

define [n: Node] Probe [x: node] and [m: msg]
  set n.Count to x.Count
  set n.Count to m.seq
  set n.Count to n.name
  set n.Count to n.Version
